// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// `language` is the account's interface locale — the UI is translated into it.
// Constrained in the app layer by LOCALES in src/lib/i18n/config.ts (re-exported
// as LANGUAGES from src/lib/profile.ts). Rendering reads the `crm_lang` cookie
// rather than this column, so the choice also applies before sign-in; this row
// is the durable copy, adopted into the cookie on sign-in.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  language     String   @default("en")
  address      String?

  // Recovery phone, stored normalised to E.164 by src/lib/phone.ts so that
  // "+855 12 345 678" and "+85512345678" are the same number to the lookup.
  // Unique because a number that reached two accounts could not identify one.
  phone           String?   @unique
  // Only a *verified* number can recover an account. Without this gate, anyone
  // who briefly held a session could point recovery at a phone they own and
  // walk back in later.
  phoneVerifiedAt DateTime?

  // The avatar lives in the row rather than on disk: it is atomic with the
  // user, needs no upload directory or cleanup pass, and SQLite handles a
  // quarter-megabyte blob without complaint. It is served by
  // src/app/avatar/[userId]/route.ts, never selected into a page query —
  // shipping the bytes through the RSC payload on every navigation is exactly
  // what the route handler exists to avoid.
  avatarData Bytes?
  avatarType String?
  // Non-null iff an avatar exists, and doubles as its cache-busting version.
  // Lets every call site ask "is there a picture?" without reading the blob.
  avatarUpdatedAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  sources       IncomeSource[]
  entries       Entry[]
  categories    ExpenseCategory[]
  recurring     RecurringExpense[]
  attachments   Attachment[]
  codes         VerificationCode[]
  loginRequests LoginRequest[]
}

// `id` is the SHA-256 of the session token, never the token itself — a leaked
// database still can't be used to mint a valid cookie.
//
// The device columns exist so Settings → Devices can answer "what is signed in
// to my account, and can I cut it off". They are descriptive only: nothing
// authenticates against them, so a spoofed user agent misleads the reader but
// grants no access.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Raw header, parsed for display by src/lib/device.ts. Stored unparsed so a
  // better parser later can re-read the original.
  userAgent String?
  ipAddress String?
  // Touched at most once every few minutes — see TOUCH_INTERVAL_MS in
  // src/lib/auth.ts. Writing on every request would double the cost of every
  // page load to keep a column that is only ever read on one screen.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A place money comes from: a salary, a shop, a rental, a dividend. Counting
// the active ones is the fourth of the four figures the dashboard studies —
// income concentrated in one source reads very differently from the same
// income spread across four.
//
// `kind` is a String because SQLite has no enum type, constrained in the app
// layer by SOURCE_KINDS in src/lib/finance.ts.
model IncomeSource {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("OTHER")
  // Archiving rather than deleting keeps historical entries attributable to a
  // source that has since dried up, while dropping it out of the active count.
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries Entry[]

  // Scoped per user, not globally: two people may both have a "Salary".
  @@unique([userId, name])
  @@index([userId, active])
}

// One line in the ledger. A single table for all three flows rather than three
// tables, because every question the dashboard asks — totals per month, ratios
// between them, a combined recent list — is a group-by over the same shape.
//
// Money is integer cents so float rounding never reaches the database, and
// `occurredOn` is date-only at UTC midnight so no time zone can shift an entry
// into a neighbouring month.
model Entry {
  id          String   @id @default(cuid())
  type        String
  amountCents Int
  occurredOn  DateTime
  // Savings buckets only — see SAVING_BUCKETS in src/lib/finance.ts. Expenses
  // moved to the `categoryId` relation below when categories became
  // user-defined; income is classified by its source. Kept for savings because
  // a bucket is a fixed vocabulary, not something worth a table.
  category    String?
  note        String?

  // Expenses only. Free text rather than a table: a payee is a label you
  // remember, not an entity with its own attributes, and forcing one row per
  // corner shop would make adding an expense a two-step chore.
  merchant String?
  // Constrained in the app layer by PAYMENT_METHODS in src/lib/expense.ts.
  paymentMethod String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Only set on income. Archiving a source keeps its entries; deleting one
  // detaches them rather than destroying the history.
  sourceId String?
  source   IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  // Only set on expenses. SetNull for the same reason as `sourceId`: deleting a
  // category must not take the spending with it.
  categoryId String?
  expenseCategory ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Set when the entry was posted automatically from a template, so a
  // catch-up run can tell what it has already written.
  recurringId String?
  recurring   RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  attachments Attachment[]

  @@index([userId, occurredOn])
  @@index([userId, type, occurredOn])
  @@index([sourceId])
  @@index([categoryId])
  @@index([recurringId])
}

// A user-defined expense category, optionally carrying a monthly budget.
//
// A table rather than the old fixed list because the nine built-ins fit nobody
// exactly, and because a budget has to live somewhere — "Food" is not a place
// you can hang a number. New accounts are given the built-ins as a starting
// point (see DEFAULT_EXPENSE_CATEGORIES in src/lib/expense.ts); from there they
// are the user's to rename, retire, or replace.
model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String
  // Monthly ceiling in integer cents. Null means "track it, don't cap it" —
  // distinct from 0, which would mean "never spend anything here".
  budgetCents Int?
  // Badge tone, constrained in the app layer by CATEGORY_TONES.
  tone        String   @default("neutral")
  // Archiving rather than deleting keeps historical entries classified.
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries   Entry[]
  recurring RecurringExpense[]

  @@unique([userId, name])
  @@index([userId, active])
}

// A photograph of a receipt, or an invoice PDF.
//
// Stored in the row for the same reasons as User.avatarData: atomic with its
// entry, no upload directory to keep in step, and never selected into a page
// query — src/app/attachment/[id]/route.ts is what serves the bytes.
//
// `userId` is denormalised off the entry so the serving route can check
// ownership without a join on every image request.
model Attachment {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  fileName  String?
  byteSize  Int
  createdAt DateTime @default(now())

  entryId String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([userId])
}

// A template for an expense that repeats every month.
//
// Posting is lazy: there is no scheduler in this app, so the ledger asks "what
// is due?" when it loads and writes anything outstanding. `lastPostedMonth`
// holds a "YYYY-MM" key, which makes that catch-up idempotent — two tabs
// loading at once cannot both post January.
model RecurringExpense {
  id            String   @id @default(cuid())
  amountCents   Int
  // Clamped to the month's real length at posting time, so 31 still works in
  // February.
  dayOfMonth    Int      @default(1)
  merchant      String?
  paymentMethod String?
  note          String?
  active        Boolean  @default(true)
  // "YYYY-MM" of the most recent month posted, or null if never.
  lastPostedMonth String?
  // Nothing is posted for months before this.
  startsOn      DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  entries Entry[]

  @@index([userId, active])
}

// A one-time numeric code sent to a phone.
//
// `codeHash` is the SHA-256 of the digits, never the digits — the same reasoning
// as Session.id. A leaked database yields no usable codes.
//
// `purpose` is a String constrained in the app layer by CODE_PURPOSES in
// src/lib/verification.ts. Rows are single-use (`consumedAt`), short-lived
// (`expiresAt`) and attempt-capped (`attempts`), because a six-digit secret is
// only worth anything if guessing is bounded.
model VerificationCode {
  id         String    @id @default(cuid())
  codeHash   String
  purpose    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// A cross-device sign-in request: the handshake behind "scan the QR".
//
// The waiting browser holds a secret (hashed here, the plaintext in an httpOnly
// cookie) and the QR carries only `id`. Approval on the phone therefore cannot
// mint a session anywhere except the browser that started the request — the id
// alone is not a credential.
//
// `userAgent` / `ipAddress` describe the *requesting* browser and exist to be
// shown to the approver. A QR someone else put in front of you is the whole
// threat here, so the approval screen has to say what it is you are letting in.
model LoginRequest {
  id         String    @id @default(cuid())
  secretHash String
  status     String    @default("PENDING")
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  // Null until approved; set to whoever approved it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
